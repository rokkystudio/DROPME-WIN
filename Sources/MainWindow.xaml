<Window x:Class="DROPME.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:neo="clr-namespace:NeoUI"
        Title="DROPME"
        Style="{StaticResource NeoResizableWindowStyle}"
        Width="720"
        Height="470"
        MinWidth="620"
        MinHeight="420"
        Background="{DynamicResource BorderBrush}"
        Closing="Window_OnClosing">
    <Border Margin="1"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <neo:NeoTitleBar x:Name="TitleBar"
                             Grid.Row="0"
                             TitleText="DROPME"
                             IconSource="/Resources/appicon.ico"
                             LanguageClick="LanguageButton_OnClick"
                             ThemeClick="ThemeButton_OnClick"
                             CloseClick="CloseButton_OnClick" />

            <Grid Grid.Row="1" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="14"
                        Background="{DynamicResource RaisedSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock x:Name="ServerTitleText"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ServerDescriptionText"
                                       Margin="0,5,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button x:Name="OpenIncomingButton"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="OpenIncomingButton_OnClick" />
                            <CheckBox x:Name="AutostartCheckBox"
                                      Style="{StaticResource OptionCheckBoxStyle}"
                                      Click="AutostartCheckBox_OnClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Padding="14"
                        Background="{DynamicResource RaisedSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="DevicesTitleText"
                                   FontSize="15"
                                   FontWeight="SemiBold" />

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="DevicesPanel" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
