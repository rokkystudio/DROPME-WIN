<Window x:Class="DROPME.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:neo="clr-namespace:NeoUI"
        xmlns:icons="clr-namespace:Icons"
        Title="DROPME"
        Style="{StaticResource NeoResizableWindowStyle}"
        Width="760"
        Height="620"
        MinWidth="640"
        MinHeight="500"
        Background="{DynamicResource BorderBrush}"
        Closing="Window_OnClosing">
    <Border Margin="1"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <neo:NeoTitleBar x:Name="TitleBar"
                             Grid.Row="0"
                             TitleText="DROPME"
                             IconSource="/Resources/appicon.ico"
                             LanguageClick="LanguageButton_OnClick"
                             ThemeClick="ThemeButton_OnClick"
                             CloseClick="CloseButton_OnClick" />

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18">
                    <Border Padding="14"
                            Background="{DynamicResource RaisedSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock x:Name="ServerTitleText"
                                       FontSize="16"
                                       FontWeight="SemiBold" />

                            <TextBlock x:Name="ServerDescriptionText"
                                       Margin="0,5,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Visibility="Collapsed" />

                            <StackPanel Margin="0,12,0,0"
                                        Orientation="Horizontal">
                                <TextBox x:Name="DeviceNameTextBox"
                                         Width="260"
                                         Height="36"
                                         VerticalContentAlignment="Center"
                                         Style="{StaticResource NeoTextBoxStyle}"
                                         TextChanged="DeviceNameTextBox_OnTextChanged" />

                                <Button x:Name="SaveDeviceNameButton"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Visibility="Collapsed"
                                        Click="SaveDeviceNameButton_OnClick" />
                            </StackPanel>

                            <TextBlock x:Name="LocalDeviceIdText"
                                       Margin="0,10,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SoftTextBrush}"
                                       TextWrapping="Wrap" />

                            <TextBlock x:Name="LocalDeviceIpText"
                                       Margin="0,4,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SoftTextBrush}"
                                       TextWrapping="Wrap" />

                            <WrapPanel Margin="0,10,0,0">
                                <CheckBox x:Name="DeviceServiceCheckBox"
                                          Margin="0,0,16,0"
                                          Style="{StaticResource OptionCheckBoxStyle}"
                                          Click="DeviceServiceCheckBox_OnClick" />
                                <CheckBox x:Name="AutostartCheckBox"
                                          Style="{StaticResource OptionCheckBoxStyle}"
                                          Visibility="Collapsed"
                                          Click="AutostartCheckBox_OnClick" />
                            </WrapPanel>

                            <Button x:Name="OpenIncomingButton"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Visibility="Collapsed"
                                    Click="OpenIncomingButton_OnClick" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0"
                            Padding="14"
                            Background="{DynamicResource RaisedSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="MyStorageTitleText"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold" />

                                <neo:NeoIconButton x:Name="AddStorageRootButton"
                                                   Grid.Column="1"
                                                   Icon="{x:Static icons:MaterialSymbols.Add}"
                                                   Click="AddStorageRootButton_OnClick" />
                            </Grid>

                            <StackPanel x:Name="MyStorageRootsPanel"
                                        Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0"
                            Padding="14"
                            Background="{DynamicResource RaisedSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock x:Name="WinFspTitleText"
                                       FontSize="15"
                                       FontWeight="SemiBold" />

                            <TextBlock x:Name="WinFspStatusText"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}" />

                            <CheckBox x:Name="UseWebInterfaceCheckBox"
                                      Margin="0,10,0,0"
                                      Style="{StaticResource OptionCheckBoxStyle}"
                                      Click="UseWebInterfaceCheckBox_OnClick" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0"
                            Padding="14"
                            Background="{DynamicResource RaisedSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock x:Name="NetworkDevicesTitleText"
                                       FontSize="15"
                                       FontWeight="SemiBold" />

                            <TextBlock x:Name="NetworkScanStatusText"
                                       Margin="0,4,0,8"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}" />

                            <StackPanel x:Name="NetworkDevicesPanel" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0"
                            Padding="14"
                            Background="{DynamicResource RaisedSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="DevicesTitleText"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <StackPanel x:Name="DevicesPanel"
                                        Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,18"
                            Padding="14"
                            Background="{DynamicResource RaisedSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock x:Name="TrustedDevicesTitleText"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="AllowedDevicesTitleText"
                                       Margin="0,10,0,5"
                                       FontWeight="SemiBold" />
                            <StackPanel x:Name="AllowedDevicesPanel" />
                            <TextBlock x:Name="BlockedDevicesTitleText"
                                       Margin="0,12,0,5"
                                       FontWeight="SemiBold" />
                            <StackPanel x:Name="BlockedDevicesPanel" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
